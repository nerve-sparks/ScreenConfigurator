# NerveSparks Auth gateway (JWKS / RS256 access tokens).
# Browser uses this API: POST /auth/login, /auth/refresh, /auth/logout
# which proxy to the gateway. Protected routes need:
#   Authorization: Bearer <access_token>
AUTH_GATEWAY_BASE_URL=https://auth.nervesparks.com
AUTH_GATEWAY_PREFIX=/api/v1/auth
AUTH_JWKS_URL=https://auth.nervesparks.com/api/v1/auth/.well-known/jwks.json
AUTH_JWT_ISSUER=auth-gateway
AUTH_JWT_AUDIENCE=auth-gateway-access
# AUTH_JWKS_CACHE_TTL_SECONDS=300

# Option A: organization LiteLLM gateway (OpenAI-compatible endpoint).
LITE_LLM_ENABLE=true
LITE_LLM_BASE_URL=https://llm.example.com/
LITE_LLM_KEY=sk-...
LITE_LLM_PROVIDER=gemini
LITE_LLM_MODEL_GEMINI=gemini/gemini-3.6-flash
LITE_LLM_MODEL_OPENAI=gpt-5.5

# Provider deadline in seconds. Allowed range: 1-120.
LLM_GENERATION_TIMEOUT_SECONDS=45

# Optional Langfuse tracing. Both keys are required to enable tracing.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Option B: direct Vertex AI through LiteLLM.
# Authenticate locally with `gcloud auth application-default login`.
MODEL=vertex_ai/gemini-3.5-flash
VERTEXAI_PROJECT=your-google-cloud-project-id
VERTEXAI_LOCATION=global

# MongoDB can be local or hosted.
MONGODB_URI=mongodb://localhost:27017

# Alternative Google AI Studio setup:
# MODEL=gemini/gemini-3.5-flash
# GEMINI_API_KEY=your-gemini-api-key
