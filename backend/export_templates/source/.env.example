# Optional agent backend auth for this standalone frontend.
# Never commit real secrets. The export never embeds API keys.
#
# Auth type comes from agent-release.json runtime.auth.type:
#   bearer | api_key_header | api_key_query | none
#
# VITE_AGENT_API_KEY=Bearer eyJhbGciOi...

VITE_AGENT_API_KEY=
